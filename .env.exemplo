# Copie para .env (que fica fora do git) e ajuste os caminhos da sua máquina.

# Clone do repositório kws-borda (código dos modelos, do MFCC e dos dados)
KWS_REPO=~/projetos/kws-borda

# Pasta com runs/, cache/ e downloads/ do treino (no Colab: MyDrive/kws-borda).
# No Mac com o Google Drive para desktop, algo como:
# ~/Library/CloudStorage/GoogleDrive-<sua conta>/My Drive/kws-borda
KWS_DRIVE=

# Opcional: onde extrair os dados (padrão: $KWS_REPO/data)
# KWS_DADOS=
